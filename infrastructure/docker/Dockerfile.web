FROM node:22-alpine AS base
RUN npm install -g pnpm@10

# --- deps stage ---
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY artifacts/trading-dashboard/package.json ./artifacts/trading-dashboard/
RUN pnpm install --frozen-lockfile --filter @workspace/trading-dashboard... --ignore-scripts

# --- builder stage ---
FROM deps AS builder
WORKDIR /app
COPY lib/api-client-react ./lib/api-client-react
COPY lib/api-zod ./lib/api-zod
COPY artifacts/trading-dashboard ./artifacts/trading-dashboard
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN pnpm --filter @workspace/trading-dashboard run build

# --- runtime stage (nginx) ---
FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/artifacts/trading-dashboard/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
